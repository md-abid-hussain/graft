# Copy to .env and fill in. .env is gitignored; this file is committed.

# ─── Postgres + pgvector (docker-compose.yml) ───
DATABASE_URL=postgres://wha:wha@localhost:5434/wehelpagents

# ─── Embeddings ───
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
# 1536, not the native 3072: pgvector's HNSW index caps at 2000 dimensions.
EMBEDDING_DIMENSIONS=1536

# ─── TrueForge ───
# 8790 for local mode (npx), 8791 for hosted mode (docker compose).
TRUEFORGE_BASE_URL=http://localhost:8791
TRUEFORGE_TOKEN=

# Agents saved in the harness, by name. The web app pins each chat to one of them, so
# these must match what you created in TrueForge or the chat opens against nothing.
TRUEFORGE_AGENT=graft-learn
TRUEFORGE_DOC_AGENT=graft-recall
TRUEFORGE_BUILD_AGENT=graft-build

# ─── MCP connectors (pnpm connectors:sync) ───
# Only needed to register connectors with TrueForge. Once synced they live in its
# database and survive a restart, so this is a one-off unless a key rotates. A
# connector whose key is missing here is skipped, not failed.

# Where TrueForge reaches this app's MCP route. Two things bite here: `localhost` is
# the container's own loopback, so this has to be the host gateway; and the port must
# match `pnpm dev`, which binds 3100 rather than Next's default because Daytona
# already holds 3000.
GRAFT_MCP_URL=http://host.docker.internal:3100/api/mcp

# The connector name the agent specs mount. Change both this and `mcp_servers[].name`
# in trueforge/agents/*.json together, or the agent mounts a connector that is not there.
GRAFT_MCP_NAME=graft

# Just the token, no scheme. GitHub's MCP takes it as the bare Authorization value;
# Bright Data and Linkup get a `Bearer ` prefix added for them. All three go into a
# header rather than a URL, because TrueForge redacts `auth.headers` and not `url`.
GITHUB_MCP_TOKEN=
BRIGHTDATA_TOKEN=
LINKUP_API_KEY=